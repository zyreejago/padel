<script is:inline>
  const venuesData = [{id:"venue-1",name:"Padel Arena Senayan",address:"Jl. Pintu Satu Senayan, Gelora, Tanah Abang, Jakarta Pusat",image:"/images/padel-1.jpeg",courts:4,type:"Indoor",hours:"06:00 - 23:00",price:"200.000",rating:4.8,reviews:124,features:["AC Central","Parkir Luas","Cafe & Lounge","Pro Shop"]},{id:"venue-2",name:"Green Padel BSD",address:"Green Office Park 6, BSD City, Tangerang Selatan",image:"/images/padel-2.jpeg",courts:6,type:"Outdoor",hours:"06:00 - 22:00",price:"150.000",rating:4.6,reviews:89,features:["View Green Area","Area BBQ","Musholla","Gazebo Istirahat"]},{id:"venue-3",name:"Urban Padel PIK",address:"Jl. Pantai Indah Kapuk, Penjaringan, Jakarta Utara",image:"/images/padel-3.webp",courts:3,type:"Indoor",hours:"07:00 - 23:00",price:"250.000",rating:4.9,reviews:67,features:["Premium Lighting","VIP Lounge","Personal Trainer","Locker Premium"]},{id:"venue-4",name:"Ciputra Padel Club",address:"Ciputra World 1, Jl. Prof. Dr. Satrio, Jakarta Selatan",image:"/images/padel-1.jpeg",courts:5,type:"Indoor + Outdoor",hours:"06:00 - 23:00",price:"180.000",rating:4.7,reviews:156,features:["Rooftop Court","Swimming Pool Access","Spa & Massage","Restaurant"]}];

  const bookingState = {
    venue: null, court: null, date: null, timeSlot: null, duration: 1,
    playerName: '', playerPhone: '', playerEmail: '', playerCount: 4,
    specialRequest: '', paymentMethod: 'transfer', paymentProof: null, bookingId: null
  };

  const steps = document.querySelectorAll('.booking-step');
  const stepIndicators = document.querySelectorAll('.step');
  const stepLines = document.querySelectorAll('.step-line');
  const venueOptions = document.querySelectorAll('.venue-option');
  const dateInput = document.getElementById('bookingDate');
  const dateChipsContainer = document.getElementById('dateChips');
  const timeSlotsContainer = document.getElementById('timeSlots');
  const playerForm = document.getElementById('playerForm');
  const paymentOptions = document.querySelectorAll('.payment-option');
  const fileInput = document.getElementById('paymentProof');
  const uploadZone = document.getElementById('uploadZone');
  const filePreview = document.getElementById('filePreview');
  const previewImage = document.getElementById('previewImage');
  const proofError = document.getElementById('proofError');
  const submitBtn = document.getElementById('submitBooking');
  const newBookingBtn = document.getElementById('newBookingBtn');
  const whatsappConfirmBtn = document.getElementById('whatsappConfirmBtn');

  function generateTimeSlots() {
    const slots = [];
    for (let h = 6; h < 22; h++) {
      const time = `${h.toString().padStart(2, '0')}:00`;
      slots.push({ time, available: Math.random() > 0.2 });
    }
    return slots;
  }

  function renderDateChips() {
    const days = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    const today = new Date();
    let html = '';
    for (let i = 0; i < 14; i++) {
      const d = new Date(today);
      d.setDate(today.getDate() + i);
      const dateStr = d.toISOString().split('T')[0];
      const isToday = i === 0;
      html += `<button type="button" class="date-chip ${isToday ? 'today' : ''}" data-date="${dateStr}">
        <span class="date-chip-day">${days[d.getDay()]}</span>
        <span class="date-chip-num">${d.getDate()}</span>
        <span class="date-chip-month">${months[d.getMonth()]}</span>
      </button>`;
    }
    dateChipsContainer.innerHTML = html;

    dateChipsContainer.querySelectorAll('.date-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        dateChipsContainer.querySelectorAll('.date-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        dateInput.value = chip.dataset.date;
        bookingState.date = chip.dataset.date;
        bookingState.timeSlot = null;
        renderTimeSlots();
        dtModalConfirm.disabled = true;
        updateSidebar();
      });
    });
  }

  function renderTimeSlots() {
    const slots = generateTimeSlots();
    timeSlotsContainer.innerHTML = slots.map((slot, i) => `
      <label class="time-slot ${slot.available ? '' : 'booked'}" tabindex="0" role="radio" aria-checked="false" data-time="${slot.time}">
        <input type="radio" name="timeSlot" value="${slot.time}" ${!slot.available ? 'disabled' : ''} hidden />
        ${slot.time}
        ${!slot.available ? '<span class="time-slot-label">Penuh</span>' : '<span class="time-slot-label">Tersedia</span>'}
      </label>
    `).join('');

    timeSlotsContainer.querySelectorAll('.time-slot:not(.booked)').forEach(el => {
      el.addEventListener('click', () => selectTimeSlot(el.dataset.time, el));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); }
      });
    });
  }

  function updateStepIndicator(currentStep) {
    stepIndicators.forEach((step, i) => {
      const stepNum = i + 1;
      step.classList.remove('active', 'completed');
      if (stepNum < currentStep) step.classList.add('completed');
      else if (stepNum === currentStep) step.classList.add('active');
    });
    stepLines.forEach((line, i) => {
      line.classList.toggle('completed', i < currentStep - 1);
    });
  }

  function showStep(stepNum) {
    steps.forEach(s => {
      s.hidden = parseInt(s.dataset.step) !== stepNum;
      s.classList.toggle('active', parseInt(s.dataset.step) === stepNum);
    });
    updateStepIndicator(stepNum);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  venueOptions.forEach(opt => {
    opt.addEventListener('click', () => selectVenue(opt.dataset.venueId, opt));
    opt.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); opt.click(); }
    });
  });

  function selectVenue(venueId, element) {
    const venue = venuesData.find(v => v.id === venueId);
    if (!venue) return;
    bookingState.venue = venue;
    bookingState.court = null;
    venueOptions.forEach(o => {
      o.setAttribute('aria-checked', 'false');
      o.querySelector('input').checked = false;
    });
    element.setAttribute('aria-checked', 'true');
    element.querySelector('input').checked = true;
    document.querySelector('#step-1 .next-step').disabled = false;
    updateSidebar();
  }

  function selectTimeSlot(time, element) {
    bookingState.timeSlot = time;
    timeSlotsContainer.querySelectorAll('.time-slot').forEach(el => {
      el.classList.remove('selected');
      el.setAttribute('aria-checked', 'false');
      el.querySelector('input').checked = false;
    });
    element.classList.add('selected');
    element.setAttribute('aria-checked', 'true');
    element.querySelector('input').checked = true;
    dtModalConfirm.disabled = false;
    updateSidebar();
  }

  playerForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (validatePlayerForm()) showStep(4);
  });

  function validatePlayerForm() {
    let valid = true;
    const name = document.getElementById('playerName');
    const phone = document.getElementById('playerPhone');
    const nameError = document.getElementById('playerNameError');
    const phoneError = document.getElementById('playerPhoneError');

    if (!name.value.trim()) {
      name.classList.add('error');
      nameError.textContent = 'Nama wajib diisi';
      nameError.style.display = 'block';
      valid = false;
    } else {
      name.classList.remove('error');
      nameError.style.display = 'none';
    }

    const phoneRegex = /^08\d{8,11}$/;
    if (!phoneRegex.test(phone.value.replace(/\s/g, ''))) {
      phone.classList.add('error');
      phoneError.textContent = 'Format nomor WA tidak valid (contoh: 08123456789)';
      phoneError.style.display = 'block';
      valid = false;
    } else {
      phone.classList.remove('error');
      phoneError.style.display = 'none';
    }

    if (valid) {
      bookingState.playerName = name.value.trim();
      bookingState.playerPhone = phone.value.replace(/\s/g, '');
      bookingState.playerEmail = document.getElementById('playerEmail').value.trim();
      bookingState.playerCount = parseInt(document.getElementById('playerCount').value);
      bookingState.specialRequest = document.getElementById('specialRequest').value.trim();
    }
    return valid;
  }

  paymentOptions.forEach(opt => {
    opt.addEventListener('click', () => selectPaymentMethod(opt.dataset.method, opt));
    opt.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); opt.click(); }
    });
  });

  function selectPaymentMethod(method, element) {
    bookingState.paymentMethod = method;
    paymentOptions.forEach(o => {
      o.setAttribute('aria-checked', 'false');
      o.querySelector('input').checked = false;
    });
    element.setAttribute('aria-checked', 'true');
    element.querySelector('input').checked = true;
    document.getElementById('transferDetails').hidden = method !== 'transfer';
    document.getElementById('qrisDetails').hidden = method !== 'qris';
  }

  document.querySelectorAll('.copy-account').forEach(btn => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.account);
      showToast('Nomor rekening disalin!', 'success');
    });
  });

  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
  uploadZone.addEventListener('drop', (e) => {
    e.preventDefault(); uploadZone.classList.remove('dragover');
    if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', (e) => { if (e.target.files[0]) handleFile(e.target.files[0]); });

  function handleFile(file) {
    if (!file.type.startsWith('image/')) { showToast('File harus berupa gambar (JPG/PNG)', 'error'); return; }
    if (file.size > 5 * 1024 * 1024) { showToast('Ukuran file maksimal 5MB', 'error'); return; }
    bookingState.paymentProof = file;
    const reader = new FileReader();
    reader.onload = (e) => {
      previewImage.src = e.target.result;
      uploadZone.hidden = true;
      filePreview.hidden = false;
      proofError.hidden = true;
    };
    reader.readAsDataURL(file);
  }

  document.querySelector('.remove-file').addEventListener('click', () => {
    bookingState.paymentProof = null;
    fileInput.value = '';
    uploadZone.hidden = false;
    filePreview.hidden = true;
  });

  submitBtn.addEventListener('click', () => {
    if (!bookingState.paymentProof) {
      proofError.hidden = false;
      uploadZone.classList.add('error');
      return;
    }
    proofError.hidden = true;
    uploadZone.classList.remove('error');
    bookingState.bookingId = 'DP-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).substr(2, 4).toUpperCase();
    const waMessage = generateWhatsAppMessage();
    whatsappConfirmBtn.href = `https://wa.me/6281234567890?text=${encodeURIComponent(waMessage)}`;
    showConfirmation();
    showStep(5);
  });

  function generateWhatsAppMessage() {
    const v = bookingState.venue;
    const date = new Date(bookingState.date).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const total = calculateTotal();
    return `Halo Demo Padel, saya mau konfirmasi booking:\n\n📋 *ID Booking:* ${bookingState.bookingId}\n🏟 *Venue:* ${v.name}\n📍 *Lokasi:* ${v.address}\n📅 *Tanggal:* ${date}\n⏰ *Jam:* ${bookingState.timeSlot} - ${parseInt(bookingState.timeSlot.split(':')[0]) + bookingState.duration}:00\n⏱ *Durasi:* ${bookingState.duration} jam\n👥 *Pemain:* ${bookingState.playerCount} orang\n💰 *Total:* Rp ${total.toLocaleString('id-ID')}\n💳 *Metode:* ${bookingState.paymentMethod === 'transfer' ? 'Transfer Bank' : 'QRIS'}\n\n👤 *Pemesan:* ${bookingState.playerName}\n📱 *WhatsApp:* ${bookingState.playerPhone}\n${bookingState.playerEmail ? `📧 *Email:* ${bookingState.playerEmail}` : ''}\n${bookingState.specialRequest ? `📝 *Catatan:* ${bookingState.specialRequest}` : ''}\n\nBukti transfer sudah diupload. Mohon dikonfirmasi ya! Terima kasih.`;
  }

  function calculateTotal() {
    const venue = bookingState.venue;
    if (!venue) return 0;
    const pricePerHour = parseInt(venue.price.replace(/\./g, ''));
    return pricePerHour * bookingState.duration;
  }

  function showConfirmation() {
    const v = bookingState.venue;
    const date = new Date(bookingState.date).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const endTime = parseInt(bookingState.timeSlot.split(':')[0]) + bookingState.duration;
    document.getElementById('confirmationDetails').innerHTML = `
      <div class="confirmation-detail"><span>Venue</span><span>${v.name}</span></div>
      <div class="confirmation-detail"><span>Tanggal</span><span>${date}</span></div>
      <div class="confirmation-detail"><span>Jam</span><span>${bookingState.timeSlot} - ${endTime.toString().padStart(2,'0')}:00</span></div>
      <div class="confirmation-detail"><span>Durasi</span><span>${bookingState.duration} jam</span></div>
      <div class="confirmation-detail"><span>Pemain</span><span>${bookingState.playerCount} orang</span></div>
      <div class="confirmation-detail"><span>Total Bayar</span><span>Rp ${calculateTotal().toLocaleString('id-ID')}</span></div>
      <div class="confirmation-detail"><span>Metode Bayar</span><span>${bookingState.paymentMethod === 'transfer' ? 'Transfer Bank' : 'QRIS'}</span></div>
      <div class="confirmation-detail"><span>Pemesan</span><span>${bookingState.playerName}</span></div>
      <div class="confirmation-detail"><span>WhatsApp</span><span>${bookingState.playerPhone}</span></div>
    `;
    document.getElementById('bookingId').textContent = bookingState.bookingId;
  }

  function updateSidebar() {
    const sidebarSummary = document.getElementById('sidebarSummary');
    const priceBreakdown = document.getElementById('priceBreakdown');
    const sidebarPrice = document.getElementById('sidebarPrice');
    const sidebarDuration = document.getElementById('sidebarDuration');
    const sidebarTotal = document.getElementById('sidebarTotal');

    if (!bookingState.venue) {
      sidebarSummary.innerHTML = '<p class="text-center" style="color: var(--gray-400); padding: 2rem;">Belum ada venue dipilih</p>';
      priceBreakdown.hidden = true;
      return;
    }

    const v = bookingState.venue;
    const pricePerHour = parseInt(v.price.replace(/\./g, ''));
    const total = bookingState.timeSlot ? pricePerHour * bookingState.duration : pricePerHour;

    sidebarSummary.innerHTML = `
      <div class="summary-item" style="margin-bottom:0.75rem;">
        <strong style="font-size:1rem;display:block;margin-bottom:0.25rem;">${v.name}</strong>
        <span style="font-size:0.8125rem;color:var(--gray-500);">${v.type} · ${v.courts} Lapangan</span>
      </div>
      ${bookingState.date ? `<div class="summary-item" style="font-size:0.875rem;margin-bottom:0.5rem;">📅 ${new Date(bookingState.date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short' })}</div>` : ''}
      ${bookingState.timeSlot ? `<div class="summary-item" style="font-size:0.875rem;">⏰ ${bookingState.timeSlot} (${bookingState.duration} jam)</div>` : ''}
    `;

    sidebarPrice.textContent = `Rp ${pricePerHour.toLocaleString('id-ID')}`;
    sidebarDuration.textContent = `${bookingState.duration} jam`;
    sidebarTotal.textContent = `Rp ${total.toLocaleString('id-ID')}`;
    priceBreakdown.hidden = false;
  }

  document.querySelectorAll('.next-step').forEach(btn => {
    btn.addEventListener('click', () => {
      const currentStep = parseInt(document.querySelector('.booking-step.active').dataset.step);
      if (currentStep === 1 && bookingState.venue) showStep(2);
      else if (currentStep === 3) playerForm.dispatchEvent(new Event('submit'));
    });
  });

  document.querySelectorAll('.prev-step').forEach(btn => {
    btn.addEventListener('click', () => {
      const currentStep = parseInt(document.querySelector('.booking-step.active').dataset.step);
      if (currentStep > 1) showStep(currentStep - 1);
    });
  });

  // DATE TIME MODAL
  const dtModalOverlay = document.getElementById('dtModalOverlay');
  const dtModalClose = document.getElementById('dtModalClose');
  const dtModalCancel = document.getElementById('dtModalCancel');
  const dtModalConfirm = document.getElementById('dtModalConfirm');
  const openDtBtn = document.getElementById('openDateTimeModal');

  function openDtModal() {
    dtModalOverlay.hidden = false;
    document.body.style.overflow = 'hidden';
    renderDateChips();
    if (bookingState.date) {
      const activeChip = dateChipsContainer.querySelector(`[data-date="${bookingState.date}"]`);
      if (activeChip) { activeChip.classList.add('active'); renderTimeSlots(); }
    }
    if (bookingState.timeSlot) dtModalConfirm.disabled = false;
  }

  function closeDtModal() {
    dtModalOverlay.hidden = true;
    document.body.style.overflow = '';
  }

  openDtBtn.addEventListener('click', openDtModal);
  dtModalClose.addEventListener('click', closeDtModal);
  dtModalCancel.addEventListener('click', closeDtModal);
  dtModalOverlay.addEventListener('click', (e) => { if (e.target === dtModalOverlay) closeDtModal(); });

  dtModalConfirm.addEventListener('click', () => {
    if (bookingState.date && bookingState.timeSlot) {
      closeDtModal();
      showStep(3);
      updateSidebar();
    }
  });

  // Remove old next-step for step 2
  document.querySelector('#step-2 .next-step')?.remove();

  newBookingBtn.addEventListener('click', () => {
    Object.keys(bookingState).forEach(k => {
      if (k !== 'bookingId') bookingState[k] = k === 'playerCount' ? 4 : (k === 'paymentMethod' ? 'transfer' : null);
    });
    bookingState.bookingId = null;
    venueOptions.forEach(o => { o.setAttribute('aria-checked', 'false'); o.querySelector('input').checked = false; });
    dateInput.value = '';
    dateChipsContainer.querySelectorAll('.date-chip').forEach(c => c.classList.remove('active'));
    renderDateChips();
    renderTimeSlots();
    playerForm.reset();
    paymentOptions.forEach(o => { o.setAttribute('aria-checked', o.dataset.method === 'transfer'); o.querySelector('input').checked = o.dataset.method === 'transfer'; });
    document.getElementById('transferDetails').hidden = false;
    document.getElementById('qrisDetails').hidden = true;
    bookingState.paymentProof = null;
    fileInput.value = '';
    uploadZone.hidden = false;
    filePreview.hidden = true;
    proofError.hidden = true;
    document.querySelector('#step-1 .next-step').disabled = true;
    dtModalConfirm.disabled = true;
    showStep(1);
    updateSidebar();
  });

  function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add('show'));
    setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 3000);
  }

  renderDateChips();
  renderTimeSlots();
  updateSidebar();
</script>
