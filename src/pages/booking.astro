---
import Layout from '../layouts/Layout.astro';
import { venues } from '../data/content.ts';
---

<Layout title="Booking Lapangan Padel - Demo Padel" description="Booking lapangan padel mudah & cepat. Pilih venue, tanggal, jam, bayar transfer/QRIS, konfirmasi langsung ke WhatsApp.">
  <section class="booking-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg>
        <span aria-current="page">Booking</span>
      </nav>
      <h1>BOOKING<br />LAPANGAN</h1>
      <p>Pilih venue, tanggal, dan jam. Proses booking cuma butuh 60 detik.</p>
    </div>
  </section>

  <section class="section bg-white" id="booking-form">
    <div class="container">
      <div class="step-indicator" id="stepIndicator" role="navigation" aria-label="Langkah booking">
        <div class="step" data-step="1">
          <div class="step-number">1</div>
          <span class="step-label">Venue</span>
        </div>
        <div class="step-line" data-step="1"></div>
        <div class="step" data-step="2">
          <div class="step-number">2</div>
          <span class="step-label">Tanggal & Jam</span>
        </div>
        <div class="step-line" data-step="2"></div>
        <div class="step" data-step="3">
          <div class="step-number">3</div>
          <span class="step-label">Data Pemain</span>
        </div>
        <div class="step-line" data-step="3"></div>
        <div class="step" data-step="4">
          <div class="step-number">4</div>
          <span class="step-label">Pembayaran</span>
        </div>
        <div class="step-line" data-step="4"></div>
        <div class="step" data-step="5">
          <div class="step-number">5</div>
          <span class="step-label">Selesai</span>
        </div>
      </div>

      <div class="booking-content">
        <div class="booking-main">
          <div class="booking-step active" id="step-1" data-step="1" role="tabpanel" aria-labelledby="step1-title">
            <h2 id="step1-title">PILIH VENUE</h2>
            <div class="venue-grid" role="radiogroup" aria-label="Pilih venue">
              {venues.map((venue, index) => (
                <label class="venue-option" tabindex="0" role="radio" aria-checked="false" data-venue-id={venue.id}>
                  <input type="radio" name="venue" value={venue.id} hidden />
                  <div class="venue-option-image">
                    <img src={venue.image} alt="" loading="lazy" />
                    <span class="venue-type">{venue.type}</span>
                    <div class="venue-option-overlay"></div>
                  </div>
                  <div class="venue-option-info">
                    <h3>{venue.name}</h3>
                    <p class="venue-address">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {venue.address.split(',').slice(0, 2).join(', ')}
                    </p>
                    <div class="venue-meta">
                      <span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {venue.courts} Lapangan
                      </span>
                      <span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        {venue.hours}
                      </span>
                    </div>
                    <div class="venue-option-bottom">
                      <div class="venue-option-price">
                        <span>Mulai</span>
                        <strong>Rp {venue.price}/jam</strong>
                      </div>
                      <div class="venue-radio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                      </div>
                    </div>
                  </div>
                </label>
              ))}
            </div>
            <div class="step-navigation">
              <button type="button" class="btn btn-primary btn-lg next-step" disabled>Lanjut: Pilih Tanggal & Jam <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
            </div>
          </div>

          <div class="booking-step" id="step-2" data-step="2" role="tabpanel" aria-labelledby="step2-title" hidden>
            <h2 id="step2-title">PILIH TANGGAL & JAM</h2>
            <p style="color:var(--gray-500);margin-bottom:1rem;">Klik tombol di bawah untuk memilih tanggal dan jam main.</p>
            <div class="step-navigation flex-between">
              <button type="button" class="btn btn-ghost prev-step"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" style="transform: rotate(180deg);"><polyline points="9 18 15 12 9 6"/></svg> Kembali</button>
              <button type="button" class="btn btn-primary btn-lg" id="openDateTimeModal">Pilih Tanggal & Jam <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></button>
            </div>
          </div>

          <div class="booking-step" id="step-3" data-step="3" role="tabpanel" aria-labelledby="step3-title" hidden>
            <h2 id="step3-title">DATA PEMAIN</h2>
            <form id="playerForm" class="player-form" novalidate>
              <div class="form-grid">
                <div class="input-group">
                  <label class="input-label" for="playerName">Nama Lengkap <span class="text-error">*</span></label>
                  <input type="text" id="playerName" name="playerName" class="input-field" placeholder="Nama lengkap kamu" required autocomplete="name" />
                  <span class="input-error" id="playerNameError"></span>
                </div>
                <div class="input-group">
                  <label class="input-label" for="playerPhone">Nomor WhatsApp <span class="text-error">*</span></label>
                  <input type="tel" id="playerPhone" name="playerPhone" class="input-field" placeholder="08xxxxxxxxxx" required autocomplete="tel" />
                  <span class="input-error" id="playerPhoneError"></span>
                </div>
                <div class="input-group">
                  <label class="input-label" for="playerEmail">Email</label>
                  <input type="email" id="playerEmail" name="playerEmail" class="input-field" placeholder="email@kamu.com" autocomplete="email" />
                </div>
                <div class="input-group">
                  <label class="input-label" for="playerCount">Jumlah Pemain</label>
                  <select id="playerCount" name="playerCount" class="input-field">
                    <option value="2">2 Orang (Singles)</option>
                    <option value="4" selected>4 Orang (Doubles)</option>
                    <option value="6">6 Orang (Rotasi)</option>
                    <option value="8">8 Orang (Turnamen Mini)</option>
                  </select>
                </div>
              </div>
              <div class="input-group">
                <label class="input-label" for="specialRequest">Catatan Khusus (Opsional)</label>
                <textarea id="specialRequest" name="specialRequest" class="input-field" rows="3" placeholder="Contoh: Butuh coach, request lapangan tertentu, dll"></textarea>
              </div>
              <div class="step-navigation flex-between">
                <button type="button" class="btn btn-ghost prev-step"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" style="transform: rotate(180deg);"><polyline points="9 18 15 12 9 6"/></svg> Kembali</button>
                <button type="submit" class="btn btn-primary btn-lg next-step">Lanjut: Pembayaran <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
              </div>
            </form>
          </div>

          <div class="booking-step" id="step-4" data-step="4" role="tabpanel" aria-labelledby="step4-title" hidden>
            <h2 id="step4-title">PEMBAYARAN</h2>
            <div class="payment-summary card">
              <h3>Ringkasan Booking</h3>
              <div id="bookingSummary"></div>
              <div class="summary-total">
                <span>Total Bayar</span>
                <strong id="totalAmount">Rp 0</strong>
              </div>
            </div>

            <div class="payment-methods">
              <h3>Metode Pembayaran</h3>
              <div class="payment-options" role="radiogroup" aria-label="Metode pembayaran">
                <label class="payment-option" tabindex="0" role="radio" aria-checked="false" data-method="transfer">
                  <input type="radio" name="paymentMethod" value="transfer" hidden checked />
                  <div class="payment-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  </div>
                  <div class="payment-info">
                    <strong>Transfer Bank</strong>
                    <span>BCA / Mandiri / BRI / BNI</span>
                  </div>
                  <div class="payment-radio"></div>
                </label>
                <label class="payment-option" tabindex="0" role="radio" aria-checked="false" data-method="qris">
                  <input type="radio" name="paymentMethod" value="qris" hidden />
                  <div class="payment-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="5" height="5"/><rect x="16" y="16" width="3" height="3"/><rect x="8" y="8" width="3" height="3"/><rect x="12" y="12" width="2" height="2"/></svg>
                  </div>
                  <div class="payment-info">
                    <strong>QRIS</strong>
                    <span>Scan & bayar lewat e-wallet</span>
                  </div>
                  <div class="payment-radio"></div>
                </label>
              </div>
            </div>

            <div class="payment-details" id="transferDetails">
              <h4>Detail Transfer Bank</h4>
              <div class="bank-account">
                <div class="bank-info">
                  <strong>Bank BCA</strong>
                  <span>Atas Nama: PT Demo Padel Indonesia</span>
                  <span class="account-number">1234567890</span>
                </div>
                <button class="btn btn-ghost btn-sm copy-account" data-account="1234567890">Salin</button>
              </div>
              <div class="bank-account">
                <div class="bank-info">
                  <strong>Bank Mandiri</strong>
                  <span>Atas Nama: PT Demo Padel Indonesia</span>
                  <span class="account-number">0987654321</span>
                </div>
                <button class="btn btn-ghost btn-sm copy-account" data-account="0987654321">Salin</button>
              </div>
            </div>

            <div class="payment-details" id="qrisDetails" hidden>
              <h4>Bayar dengan QRIS</h4>
              <div class="qris-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="64" height="64" style="color: var(--gray-400);"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="5" height="5"/><rect x="16" y="16" width="3" height="3"/><rect x="8" y="8" width="3" height="3"/><rect x="12" y="12" width="2" height="2"/></svg>
                <p>QR Code akan muncul di sini</p>
                <span class="text-caption">Demo: QRIS statis untuk semua bank & e-wallet</span>
              </div>
            </div>

            <div class="upload-proof">
              <h4>Upload Bukti Pembayaran</h4>
              <div class="file-upload" id="fileUpload">
                <input type="file" id="paymentProof" name="paymentProof" accept="image/*" hidden />
                <div class="upload-zone" id="uploadZone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" style="color: var(--primary); margin-bottom: 0.75rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  <p>Klik atau tarik bukti transfer di sini</p>
                  <span class="text-caption">Format: JPG, PNG. Max 5MB</span>
                </div>
                <div class="file-preview" id="filePreview" hidden>
                  <img id="previewImage" src="" alt="Preview bukti bayar" />
                  <button type="button" class="remove-file" aria-label="Hapus file"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                </div>
              </div>
              <p id="proofError" class="input-error" hidden>Bukti pembayaran wajib diupload</p>
            </div>

            <div class="step-navigation flex-between">
              <button type="button" class="btn btn-ghost prev-step"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" style="transform: rotate(180deg);"><polyline points="9 18 15 12 9 6"/></svg> Kembali</button>
              <button type="button" class="btn btn-accent btn-lg next-step" id="submitBooking">Konfirmasi & Kirim ke WhatsApp <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/></svg></button>
            </div>
          </div>

          <div class="booking-step" id="step-5" data-step="5" role="tabpanel" aria-labelledby="step5-title" hidden>
            <div class="confirmation-success text-center">
              <div class="success-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="80" height="80"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
              </div>
              <h2>BOOKING BERHASIL!</h2>
              <p style="color: var(--gray-500); margin: 1rem 0 2rem;">ID booking kamu telah dibuat. Silakan konfirmasi pembayaran via WhatsApp.</p>

              <div class="booking-id-card card">
                <h3>Detail Booking</h3>
                <div id="confirmationDetails"></div>
                <div class="booking-id">
                  <span class="text-caption">ID Booking</span>
                  <strong id="bookingId"></strong>
                </div>
              </div>

              <a id="whatsappConfirmBtn" href="#" target="_blank" rel="noopener" class="btn btn-accent btn-lg wa-confirm-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Konfirmasi via WhatsApp
              </a>

              <button type="button" class="btn btn-outline" id="newBookingBtn">Booking Lagi</button>
            </div>
          </div>
        </div>

        <aside class="booking-sidebar" aria-label="Ringkasan booking">
          <div class="sidebar-card card sticky-sidebar">
            <h3>RINGKASAN</h3>
            <div id="sidebarSummary">
              <p class="text-center" style="color: var(--gray-400); padding: 2rem;">Belum ada venue dipilih</p>
            </div>
            <div class="sidebar-divider"></div>
            <div class="price-breakdown" id="priceBreakdown" hidden>
              <div class="price-row"><span>Harga/jam</span><span id="sidebarPrice">Rp 0</span></div>
              <div class="price-row"><span>Durasi</span><span id="sidebarDuration">0 jam</span></div>
              <div class="price-row total"><span>Total</span><strong id="sidebarTotal">Rp 0</strong></div>
            </div>
            <div class="sidebar-note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Gak ada biaya tersembunyi. Harga final = harga yang tertera.</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- DATE TIME MODAL -->
  <div class="dt-modal-overlay" id="dtModalOverlay" hidden>
    <div class="dt-modal">
      <div class="dt-modal-header">
        <h2>PILIH TANGGAL & JAM</h2>
        <button type="button" class="dt-modal-close" id="dtModalClose" aria-label="Tutup">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="dt-modal-body">
        <div class="dt-modal-section">
          <label class="input-label">Tanggal Main</label>
          <div class="date-picker-row" id="datePickerRow">
            <button type="button" class="date-arrow" id="datePrev" aria-label="Sebelumnya">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="date-chips" id="dateChips"></div>
            <button type="button" class="date-arrow" id="dateNext" aria-label="Selanjutnya">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
          <input type="date" id="bookingDate" class="input-field" min={new Date().toISOString().split('T')[0]} required hidden />
        </div>

        <div class="dt-modal-section">
          <label class="input-label">Pilih Jam</label>
          <div class="time-grid" id="timeSlots" role="radiogroup" aria-label="Pilih jam main">
            <p class="text-center" style="color: var(--gray-400); padding: 2rem; grid-column: 1/-1;">Pilih tanggal dulu untuk melihat jam yang tersedia</p>
          </div>
          <div class="time-legend">
            <span class="legend-item"><span class="legend-dot available"></span> Tersedia</span>
            <span class="legend-item"><span class="legend-dot booked"></span> Penuh</span>
            <span class="legend-item"><span class="legend-dot selected"></span> Dipilih</span>
          </div>
        </div>
      </div>

      <div class="dt-modal-footer">
        <button type="button" class="btn btn-ghost" id="dtModalCancel">Batal</button>
        <button type="button" class="btn btn-primary btn-lg" id="dtModalConfirm" disabled>
          Konfirmasi
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .booking-hero {
    padding: calc(var(--header-h) + clamp(2rem,5vw,3rem)) 0 clamp(2rem,4vw,2.5rem);
    background: var(--primary-dark);
    color: #fff;
  }
  .booking-hero .container { max-width: 800px; }
  .breadcrumb { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: rgba(255,255,255,0.45); margin-bottom: 1rem; }
  .breadcrumb a { color: rgba(255,255,255,0.45); }
  .breadcrumb a:hover { color: var(--accent); }
  .booking-hero h1 { font-size: clamp(2.5rem,6vw,4rem); color: #fff; margin-bottom: 0.5rem; line-height: 1; letter-spacing: -0.03em; }
  .booking-hero p { font-size: 1rem; color: rgba(255,255,255,0.6); }

  /* STEP INDICATOR */
  .step-indicator {
    display: flex; align-items: center; justify-content: center;
    gap: 0.5rem; margin-bottom: 3rem; flex-wrap: wrap;
  }
  .step { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .step-number {
    width: 48px; height: 48px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 0.9375rem;
    background: var(--gray-100); color: var(--gray-400);
    transition: all 0.4s var(--ease-out-expo);
  }
  .step.active .step-number {
    background: var(--primary); color: #fff;
    box-shadow: 0 6px 20px rgba(10,61,50,0.35);
  }
  .step.completed .step-number { background: var(--success); color: #fff; }
  .step-label { font-size: 0.6875rem; font-weight: 700; color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.06em; }
  .step.active .step-label { color: var(--primary); }
  .step-line { width: 52px; height: 2px; background: var(--gray-200); transition: background 0.3s; }
  .step-line.completed { background: var(--success); }

  /* LAYOUT */
  .booking-content { display: grid; grid-template-columns: 1fr 360px; gap: 2rem; align-items: start; }
  .booking-step { animation: stepIn 0.35s var(--ease-out-expo); }
  @keyframes stepIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  .booking-step h2 { font-size: 1.5rem; margin-bottom: 1.5rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; }

  /* VENUE CARDS */
  .venue-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
  .venue-option {
    position: relative; display: flex; flex-direction: column;
    border: 2px solid var(--gray-200); border-radius: var(--radius-xl);
    overflow: hidden; cursor: pointer;
