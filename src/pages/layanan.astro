---
import Layout from '../layouts/Layout.astro';
import { services, faqs } from '../data/content.ts';
---

<Layout title="Layanan Padel - Demo Padel" description="Layanan lengkap padel: sewa lapangan, sewa alat, coaching pribadi, event & turnamen, F&B.">
  <section class="ly-page-hero">
    <div class="ly-hero-bg" style="background-image: url('/images/padel-1.jpeg')"></div>
    <div class="ly-hero-overlay"></div>
    <div class="container ly-hero-content">
      <nav class="ly-breadcrumb"><a href="/">Beranda</a> <span>/</span> <span>Layanan</span></nav>
      <h1>LAYANAN<br />KAMI</h1>
      <p>Semua yang kamu butuh buat main padel — dari lapangan, alat, coaching, sampe event. Lengkap, gampang, transparan.</p>
    </div>
  </section>

  <section class="ly-services" id="layanan">
    <div class="container">
      {services.map((s, i) => (
        <div class={`ly-svc-card ${i % 2 === 1 ? 'ly-svc-card--reverse' : ''}`} id={s.id}>
          <div class="ly-svc-visual">
            <div class="ly-svc-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="ly-svc-icon-wrap">
              {s.icon === 'court' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>}
              {s.icon === 'equipment' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>}
              {s.icon === 'coaching' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              {s.icon === 'trophy' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V14.66"/><path d="M18 2H6"/></svg>}
              {s.icon === 'coffee' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9a1 1 0 0 1 1-1h10"/><path d="M7 3h10"/></svg>}
            </div>
          </div>
          <div class="ly-svc-body">
            <div class="ly-svc-tags">
              {s.popular && <span class="ly-svc-badge">Populer</span>}
              <span class="ly-svc-price-tag">Rp {s.price}<span class="ly-svc-price-unit">{s.unit}</span></span>
            </div>
            <h2 class="ly-svc-title">{s.title}</h2>
            <p class="ly-svc-desc">{s.description}</p>
            <ul class="ly-svc-features">
              {s.features.map(f => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <div class="ly-svc-actions">
              <a href="/booking" class="ly-btn-primary">Booking Sekarang</a>
              <a href={`https://wa.me/6281234567890?text=Halo%20Demo%20Padel%2C%20saya%20mau%20tanya%20tentang%20${encodeURIComponent(s.title)}`} target="_blank" rel="noopener" class="ly-btn-outline">Tanya via WA</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="ly-faq" id="faq">
    <div class="container">
      <div class="ly-faq-header">
        <span class="ly-faq-tag">Pertanyaan Umum</span>
        <h2 class="ly-faq-heading">FAQ LAYANAN</h2>
      </div>
      <div class="ly-faq-list">
        {faqs.map((faq, i) => (
          <details class="ly-faq-item" open={i === 0}>
            <summary>
              <span class="ly-faq-q">{faq.question}</span>
              <span class="ly-faq-toggle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12" class="ly-faq-plus"/></svg>
              </span>
            </summary>
            <div class="ly-faq-body"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="ly-cta">
    <div class="container ly-cta-inner">
      <div class="ly-cta-left">
        <h2>MASIH PUNYA<br />PERTANYAAN?</h2>
        <p>Tim kami siap bantu jawab semua pertanyaan kamu.</p>
      </div>
      <a href="https://wa.me/6281234567890?text=Halo%20Demo%20Padel%2C%20saya%20mau%20tanya%20tentang%20layanan" target="_blank" rel="noopener" class="ly-cta-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Chat via WhatsApp
      </a>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .ly-page-hero {
    position: relative; min-height: 50vh;
    display: flex; align-items: flex-end;
    padding: calc(var(--header-h) + clamp(3rem,6vw,5rem)) 0 clamp(2rem,4vw,3rem);
    overflow: hidden;
  }
  .ly-hero-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .ly-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.2) 100%);
  }
  .ly-hero-content { position: relative; z-index: 2; color: #fff; }
  .ly-breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.8125rem; color: rgba(255,255,255,0.4); margin-bottom: 1.25rem;
  }
  .ly-breadcrumb a { color: rgba(255,255,255,0.4); text-decoration: none; transition: color 0.2s; }
  .ly-breadcrumb a:hover { color: var(--accent); }
  .ly-hero-content h1 {
    font-family: var(--font-display); font-size: clamp(3rem,7vw,5.5rem);
    font-weight: 900; text-transform: uppercase; line-height: 0.92;
    letter-spacing: -0.03em; margin-bottom: 1rem;
    color: #fff;
  }
  .ly-hero-content p { font-size: 1.0625rem; color: rgba(255,255,255,0.6); max-width: 520px; line-height: 1.7; }

  /* SERVICES */
  .ly-services { padding: clamp(3rem,6vw,5rem) 0; }
  .ly-svc-card {
    display: grid; grid-template-columns: 1fr 1.4fr;
    gap: clamp(2rem,4vw,4rem); align-items: center;
    padding: clamp(2rem,4vw,3rem) 0;
    border-bottom: 1px solid var(--gray-100);
  }
  .ly-svc-card:last-child { border-bottom: none; }
  .ly-svc-card--reverse { direction: rtl; }
  .ly-svc-card--reverse > * { direction: ltr; }

  .ly-svc-visual {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1; background: var(--cream); border-radius: 24px;
    overflow: hidden;
  }
  .ly-svc-num {
    position: absolute; top: 1rem; left: 1.25rem;
    font-size: 5rem; font-weight: 900; color: rgba(10,61,50,0.06);
    line-height: 1; letter-spacing: -0.05em;
  }
  .ly-svc-icon-wrap {
    width: 120px; height: 120px;
    border-radius: 50%; background: var(--primary);
    display: flex; align-items: center; justify-content: center;
    color: #fff; transition: transform 0.4s var(--ease-out-expo);
  }
  .ly-svc-card:hover .ly-svc-icon-wrap { transform: scale(1.08) rotate(-5deg); }

  .ly-svc-tags { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
  .ly-svc-badge {
    padding: 0.3rem 0.875rem; background: var(--accent); color: var(--dark);
    border-radius: 999px; font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .ly-svc-price-tag {
    font-size: 1.75rem; font-weight: 900; color: var(--primary);
    letter-spacing: -0.02em;
  }
  .ly-svc-price-unit { font-size: 0.875rem; font-weight: 500; color: var(--gray-400); }
  .ly-svc-title {
    font-size: clamp(1.5rem,3vw,2.25rem); font-weight: 900;
    text-transform: uppercase; letter-spacing: -0.02em;
    line-height: 1.05; margin-bottom: 0.75rem; color: var(--dark);
  }
  .ly-svc-desc { font-size: 1rem; color: var(--gray-600); line-height: 1.75; margin-bottom: 1.25rem; }
  .ly-svc-features {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .ly-svc-features li {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: var(--gray-600);
  }
  .ly-svc-features svg { color: var(--primary); flex-shrink: 0; }

  .ly-svc-actions { display: flex; gap: 0.75rem; }
  .ly-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.875rem 2rem; background: var(--primary); color: #fff;
    border-radius: 999px; font-weight: 700; font-size: 0.875rem;
    text-transform: uppercase; letter-spacing: 0.04em;
    text-decoration: none; transition: all 0.3s ease; flex: 1;
  }
  .ly-btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); }
  .ly-btn-outline {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.875rem 2rem; border: 2px solid var(--gray-200); color: var(--dark);
    border-radius: 999px; font-weight: 700; font-size: 0.875rem;
    text-transform: uppercase; letter-spacing: 0.04em;
    text-decoration: none; transition: all 0.3s ease; flex: 1;
  }
  .ly-btn-outline:hover { border-color: var(--primary); color: var(--primary); }

  /* FAQ */
  .ly-faq {
    padding: clamp(4rem,8vw,6rem) 0;
    background: var(--cream);
  }
  .ly-faq-header { text-align: center; margin-bottom: clamp(2rem,4vw,3rem); }
  .ly-faq-tag {
    display: inline-block; font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--primary); background: rgba(10,61,50,0.08);
    padding: 0.375rem 0.875rem; border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .ly-faq-heading {
    font-family: var(--font-display); font-size: clamp(2rem,4vw,3rem);
    font-weight: 900; text-transform: uppercase; letter-spacing: -0.03em;
  }
  .ly-faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.75rem; }
  .ly-faq-item {
    background: var(--white); border-radius: 16px;
    border: 1px solid var(--gray-100); overflow: hidden;
    transition: all 0.3s ease;
  }
  .ly-faq-item[open] { border-color: var(--primary); box-shadow: 0 4px 20px rgba(10,61,50,0.08); }
  .ly-faq-item summary {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.25rem 1.5rem; cursor: pointer;
    font-weight: 700; font-size: 1rem; color: var(--dark);
    list-style: none; gap: 1rem;
  }
  .ly-faq-item summary::-webkit-details-marker { display: none; }
  .ly-faq-toggle {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--cream); display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: all 0.3s ease; color: var(--gray-400);
  }
  .ly-faq-item[open] .ly-faq-toggle { background: var(--primary); color: #fff; transform: rotate(45deg); }
  .ly-faq-plus { transition: transform 0.3s ease; }
  .ly-faq-body {
    padding: 0 1.5rem 1.5rem;
    color: var(--gray-600); line-height: 1.75; font-size: 0.9375rem;
    animation: ly-faq-open 0.3s ease;
  }
  @keyframes ly-faq-open { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }

  /* CTA */
  .ly-cta {
    background: var(--primary-dark); padding: clamp(4rem,8vw,6rem) 0;
  }
  .ly-cta-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
  }
  .ly-cta-left h2 { color: #fff; margin-bottom: 0.5rem; }
  .ly-cta-left p { color: rgba(255,255,255,0.6); }
  .ly-cta-btn {
    display: inline-flex; align-items: center; gap: 0.75rem;
    padding: 1rem 2.5rem; background: var(--accent); color: var(--dark);
    border-radius: 999px; font-weight: 800; font-size: 1rem;
    text-transform: uppercase; letter-spacing: 0.04em;
    text-decoration: none; transition: all 0.3s ease; white-space: nowrap;
  }
  .ly-cta-btn:hover { background: #fff; transform: translateY(-2px); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .ly-svc-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .ly-svc-card--reverse { direction: ltr; }
    .ly-svc-visual { aspect-ratio: 16/9; }
    .ly-svc-features { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .ly-cta-inner { flex-direction: column; text-align: center; }
    .ly-cta-btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Hero entrance
  gsap.from('.ly-hero-content > *', {
    y: 50, opacity: 0, duration: 0.8, stagger: 0.1, ease: 'power3.out', delay: 0.2,
  });

  // Service cards alternating
  gsap.utils.toArray('.ly-svc-card').forEach((card, i) => {
    const visual = card.querySelector('.ly-svc-visual');
    const body = card.querySelector('.ly-svc-body');
    const isReverse = card.classList.contains('ly-svc-card--reverse');

    gsap.from(visual, {
      x: isReverse ? 80 : -80, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: card, start: 'top 80%' },
    });
    gsap.from(body, {
      x: isReverse ? -80 : 80, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: card, start: 'top 80%' },
    });
  });

  // FAQ items
  gsap.from('.ly-faq-item', {
    y: 30, opacity: 0, duration: 0.5, stagger: 0.08, ease: 'power3.out',
    scrollTrigger: { trigger: '.ly-faq-list', start: 'top 80%' },
  });

  // CTA
  gsap.from('.ly-cta-inner > *', {
    y: 40, opacity: 0, duration: 0.7, stagger: 0.15, ease: 'power3.out',
    scrollTrigger: { trigger: '.ly-cta', start: 'top 85%' },
  });
</script>
