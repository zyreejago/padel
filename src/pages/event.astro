---
import Layout from '../layouts/Layout.astro';
import { events } from '../data/content.ts';

function fmtDate(start: string, end: string): string {
  const o: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' };
  const s = new Date(start).toLocaleDateString('id-ID', o);
  if (start === end) return s;
  return `${s} - ${new Date(end).toLocaleDateString('id-ID', o)}`;
}
---

<Layout title="Event & Turnamen - Demo Padel" description="Jadwal event & turnamen padel terbaru.">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb"><a href="/">Beranda</a> / <span>Event</span></nav>
      <h1>EVENT &<br />TURNAMEN</h1>
      <p>Dari turnamen kompetitif sampai clinic santai & komunitas.</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="filter-bar" id="eventFilter">
        <button class="filter-pill active" data-filter="all">Semua</button>
        <button class="filter-pill" data-filter="turnamen">Turnamen</button>
        <button class="filter-pill" data-filter="corporate">Corporate</button>
        <button class="filter-pill" data-filter="coaching">Coaching</button>
        <button class="filter-pill" data-filter="komunitas">Komunitas</button>
      </div>

      <div class="event-grid">
        {events.map((e) => (
          <div class="event-card" data-cat={e.category.toLowerCase()}>
            <div class="ev-img">
              <img src={e.image} alt={e.title} loading="lazy" />
              <div class="ev-img-overlay"></div>
              <span class="ev-cat">{e.category}</span>
              <span class="ev-status">{e.status}</span>
            </div>
            <div class="ev-body">
              <div class="ev-meta">
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  {fmtDate(e.date, e.endDate)}
                </span>
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {e.venue}
                </span>
              </div>
              <h3>{e.title}</h3>
              <p class="ev-desc">{e.description}</p>
              <div class="ev-details">
                <span class="ev-level">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                  {e.level}
                </span>
                <span class="ev-price">Rp {e.price}</span>
              </div>
              <div class="ev-actions">
                <a href="/booking" class="btn btn-primary" style="flex:1;">{e.status}</a>
                <a href="https://wa.me/6281234567890?text=Halo%20Demo%20Padel%2C%20saya%20mau%20daftar%20{encodeURIComponent(e.title)}" target="_blank" rel="noopener" class="btn btn-ghost" style="flex:1;">Info via WA</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: calc(var(--header-h) + clamp(2rem,5vw,4rem)) 0 clamp(2rem,5vw,3rem);
    background: var(--primary-dark); color: #fff;
  }
  .page-hero h1 { color: #fff; margin-bottom: 0.5rem; font-size: clamp(2.5rem,6vw,4rem); line-height: 1; }
  .page-hero p { color: rgba(255,255,255,0.6); font-size: 1.0625rem; }
  .breadcrumb { font-size: 0.8125rem; color: rgba(255,255,255,0.45); margin-bottom: 1rem; }
  .breadcrumb a { color: rgba(255,255,255,0.45); }
  .breadcrumb a:hover { color: var(--accent); }

  .filter-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 3rem; }
  .filter-pill {
    padding: 0.625rem 1.5rem; border-radius: var(--radius-full);
    border: 2px solid var(--gray-200); background: var(--white);
    font-weight: 700; font-size: 0.8125rem; color: var(--gray-600);
    text-transform: uppercase; letter-spacing: 0.04em;
    transition: all 0.25s ease;
  }
  .filter-pill:hover { border-color: var(--primary); color: var(--primary); }
  .filter-pill.active { border-color: var(--primary); background: var(--primary); color: #fff; }

  .event-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .event-card {
    display: flex; flex-direction: column;
    border-radius: var(--radius-xl);
    overflow: hidden; background: var(--white);
    border: 1px solid var(--gray-100);
    transition: all 0.4s var(--ease-out-expo);
  }
  .event-card:hover { box-shadow: var(--shadow-xl); transform: translateY(-6px); }

  .ev-img { position: relative; aspect-ratio: 16/10; overflow: hidden; }
  .ev-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .event-card:hover .ev-img img { transform: scale(1.05); }
  .ev-img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);
  }
  .ev-cat {
    position: absolute; top: 0.75rem; left: 0.75rem;
    padding: 0.3rem 0.875rem; background: var(--primary); color: #fff;
    border-radius: var(--radius-full); font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .ev-status {
    position: absolute; top: 0.75rem; right: 0.75rem;
    padding: 0.3rem 0.875rem; background: var(--accent); color: var(--dark);
    border-radius: var(--radius-full); font-size: 0.6875rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.06em;
  }

  .ev-body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .ev-meta { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--gray-400); margin-bottom: 0.75rem; }
  .ev-meta span { display: flex; align-items: center; gap: 0.25rem; }
  .ev-body h3 { font-size: 1.25rem; margin-bottom: 0.5rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; }
  .ev-desc { font-size: 0.875rem; color: var(--gray-500); margin-bottom: 1rem; flex: 1; line-height: 1.7; }
  .ev-details {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 0.75rem; border-top: 1px solid var(--gray-100);
    margin-bottom: 1rem;
  }
  .ev-level { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--gray-500); }
  .ev-price { font-size: 1.125rem; font-weight: 800; color: var(--primary); }
  .ev-actions { display: flex; gap: 0.5rem; margin-top: auto; }

  @media (max-width: 768px) {
    .event-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.page-hero > .container > *', {
    y: 50, opacity: 0, duration: 0.8, stagger: 0.1, ease: 'power3.out', delay: 0.2,
  });

  gsap.from('.filter-pill', {
    y: 20, opacity: 0, duration: 0.4, stagger: 0.06, ease: 'power3.out',
    scrollTrigger: { trigger: '.filter-bar', start: 'top 85%' },
  });

  gsap.from('.event-card', {
    y: 60, opacity: 0, scale: 0.95, duration: 0.7,
    stagger: 0.1, ease: 'power3.out',
    scrollTrigger: { trigger: '.event-grid', start: 'top 80%' },
  });

  const pills = document.querySelectorAll('.filter-pill');
  const cards = document.querySelectorAll('.event-card');
  pills.forEach(p => {
    p.addEventListener('click', () => {
      pills.forEach(x => x.classList.remove('active'));
      p.classList.add('active');
      const f = p.dataset.filter;
      cards.forEach(c => {
        const cat = c.dataset.cat;
        if (f === 'all' || cat.includes(f)) {
          c.style.display = 'flex';
          gsap.from(c, { y: 30, opacity: 0, duration: 0.4, ease: 'power3.out' });
        } else {
          c.style.display = 'none';
        }
      });
    });
  });
</script>
