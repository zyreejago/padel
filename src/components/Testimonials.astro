---
import { testimonials } from '../data/content.ts';
---

<section class="section bg-white" aria-labelledby="test-title">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Testimoni</span>
      <h2 id="test-title">Pemain Padel<br />Percaya Demo Padel</h2>
      <p>Lihat apa kata mereka yang sudah main lewat platform kami.</p>
    </header>

    <div class="test-slider" id="testSlider">
      <div class="test-track">
        {testimonials.map((t) => (
          <div class="test-card">
            <div class="test-stars">
              {[...Array(5)].map((_, i) => (
                <svg viewBox="0 0 24 24" fill={i < t.rating ? 'var(--accent)' : 'var(--gray-200)'} width="16" height="16"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <blockquote>&ldquo;{t.text}&rdquo;</blockquote>
            <footer class="test-footer">
              <img src={t.avatar} alt="" loading="lazy" />
              <div>
                <cite>{t.name}</cite>
                <span>{t.role}</span>
              </div>
            </footer>
            <div class="test-venue">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {t.venue}
            </div>
          </div>
        ))}
      </div>

      <div class="test-controls">
        <button class="test-btn" id="testPrev" aria-label="Sebelumnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="test-dots" id="testDots">
          {testimonials.map((_, i) => (
            <button class={`test-dot ${i === 0 ? 'active' : ''}`} data-i={i} aria-label={`Testimoni ${i+1}`}></button>
          ))}
        </div>
        <button class="test-btn" id="testNext" aria-label="Selanjutnya">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .test-slider { max-width: 900px; margin: 0 auto; }
  .test-track {
    display: flex; gap: 1.5rem;
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
    padding: 0.5rem;
  }
  .test-track::-webkit-scrollbar { display: none; }

  .test-card {
    flex: 0 0 calc(50% - 0.75rem);
    min-width: 320px;
    scroll-snap-align: start;
    padding: 2rem;
    background: var(--white);
    border-radius: var(--radius-xl);
    border: 1px solid var(--gray-100);
    transition: all 0.35s ease;
  }
  .test-card:hover { box-shadow: var(--shadow-xl); border-color: transparent; }

  .test-stars { display: flex; gap: 2px; margin-bottom: 1.25rem; }

  .test-card blockquote {
    font-size: 0.9375rem; line-height: 1.75;
    color: var(--gray-700); margin-bottom: 1.25rem;
    font-style: normal; position: relative;
  }

  .test-footer {
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .test-footer img {
    width: 44px; height: 44px; border-radius: 50%;
    object-fit: cover;
  }
  .test-footer cite {
    font-style: normal; font-weight: 800;
    font-size: 0.875rem; color: var(--dark);
    display: block;
  }
  .test-footer span { font-size: 0.8125rem; color: var(--gray-400); }

  .test-venue {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; color: var(--gray-500);
  }

  .test-controls {
    display: flex; align-items: center; justify-content: center;
    gap: 1rem; margin-top: 2rem;
  }
  .test-btn {
    width: 48px; height: 48px; border-radius: 50%;
    border: 2px solid var(--gray-200);
    display: flex; align-items: center; justify-content: center;
    color: var(--gray-600);
    transition: all 0.3s ease;
  }
  .test-btn:hover {
    background: var(--primary); border-color: var(--primary); color: #fff;
  }
  .test-dots { display: flex; gap: 0.5rem; }
  .test-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--gray-200);
    transition: all 0.3s ease;
  }
  .test-dot.active { background: var(--primary); transform: scale(1.4); }

  @media (max-width: 768px) {
    .test-card { flex: 0 0 85%; min-width: 280px; }
  }
  @media (max-width: 480px) {
    .test-card { flex: 0 0 100%; min-width: 100%; }
  }
</style>

<script is:inline>
  const slider = document.getElementById('testSlider');
  if (slider) {
    const track = slider.querySelector('.test-track');
    const cards = slider.querySelectorAll('.test-card');
    const dots = slider.querySelectorAll('.test-dot');
    const prev = document.getElementById('testPrev');
    const next = document.getElementById('testNext');
    let idx = 0;

    function go(i) {
      if (!cards[0]) return;
      idx = Math.max(0, Math.min(i, cards.length - 1));
      const w = cards[0].offsetWidth + 24;
      track.scrollTo({ left: idx * w, behavior: 'smooth' });
      dots.forEach((d, j) => d.classList.toggle('active', j === idx));
    }

    prev?.addEventListener('click', () => go(idx - 1));
    next?.addEventListener('click', () => go(idx + 1));
    dots.forEach(d => d.addEventListener('click', () => go(+d.dataset.i)));

    let auto = setInterval(() => go(idx >= cards.length - 1 ? 0 : idx + 1), 5000);
    slider.addEventListener('mouseenter', () => clearInterval(auto));
    slider.addEventListener('mouseleave', () => {
      auto = setInterval(() => go(idx >= cards.length - 1 ? 0 : idx + 1), 5000);
    });
  }
</script>
